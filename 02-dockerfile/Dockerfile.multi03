# ===== Dockerfile.multi03 =====
# Node.js app — Multi-stage build
# เปรียบเทียบขนาดกับ Dockerfile.multi03-single

# ---- Stage 1: Install dependencies ----
FROM node:22-alpine AS builder

WORKDIR /app

COPY app-node/package.json .

# install เฉพาะ production dependencies
RUN npm install --omit=dev

# ---- Stage 2: Runtime ----
FROM node:22-alpine

# สร้าง user แทน root
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# copy เฉพาะ production node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY app-node/server.js .
COPY app-node/package.json .

USER appuser

EXPOSE 3000
CMD ["node", "server.js"]

# Build:  docker build -f Dockerfile.multi03 -t workshop-node-multi .
# Run:    docker run --rm -p 3000:3000 workshop-node-multi
# Size:   docker images workshop-node-multi
#         ≈ 130 MB (alpine + production deps เท่านั้น)
#
# ============================================
# 🔥 เปรียบเทียบขนาด:
#   docker images | grep workshop-node
#
#   workshop-node-single   latest   ~1100 MB
#   workshop-node-multi    latest   ~130 MB
#
#   ลดลง ~88%!!
# ============================================
